# Backup strategy (GitLab-level, Gitaly, database, cache, secrets):
#   1. Nightly backup-utility CronJob -> S3 "backups" (DB dump + uploads, artifacts, LFS, packages ...)
#   2. Gitaly server-side repository backups -> S3 "gitaly-backups" (triggered by the same job)
#   3. Daily EBS snapshots of the Gitaly volume (AWS DLM, selected by the StorageClass tag)
#   4. RDS automated backups + point-in-time recovery; ElastiCache daily snapshots
#   5. gitlab-rails-secret copied to Secrets Manager (restores are impossible without it)
#   6. S3 versioning + lifecycle on the backup buckets; Gitaly volume reclaimPolicy Retain

locals {
  gitaly_snapshot_tag = { key = "gitlab-backup", value = "${local.prefix}-gitaly" }
}

resource "aws_iam_role" "dlm" {
  name = "${local.prefix}-dlm"
  assume_role_policy = jsonencode({
    Version   = "2012-10-17"
    Statement = [{ Effect = "Allow", Principal = { Service = "dlm.amazonaws.com" }, Action = "sts:AssumeRole" }]
  })
}

resource "aws_iam_role_policy_attachment" "dlm" {
  role       = aws_iam_role.dlm.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole"
}

resource "aws_dlm_lifecycle_policy" "gitaly" {
  description        = "${local.prefix} Gitaly volume daily snapshots"
  execution_role_arn = aws_iam_role.dlm.arn
  state              = "ENABLED"

  policy_details {
    resource_types = ["VOLUME"]
    target_tags    = { (local.gitaly_snapshot_tag.key) = local.gitaly_snapshot_tag.value }

    schedule {
      name      = "daily"
      copy_tags = true
      create_rule {
        interval      = 24
        interval_unit = "HOURS"
        times         = ["21:30"] # 03:00 IST
      }
      retain_rule {
        count = var.gitaly_snapshot_retention
      }
      tags_to_add = { "snapshot-of" = "gitaly" }
    }
  }
}

# External-service credentials, kept outside Terraform state consumers.
resource "aws_secretsmanager_secret" "services" {
  name       = "${local.prefix}/gitlab-external-services"
  kms_key_id = aws_kms_key.gitlab.arn
}

resource "aws_secretsmanager_secret_version" "services" {
  secret_id = aws_secretsmanager_secret.services.id
  secret_string = jsonencode({
    postgres_host     = aws_db_instance.gitlab.address
    postgres_password = random_password.db.result
    redis_host        = aws_elasticache_replication_group.gitlab.primary_endpoint_address
    redis_auth_token  = random_password.redis.result
  })
}

# GitLab's own encryption keys (generated by the chart on first install).
data "kubernetes_secret_v1" "rails" {
  metadata {
    name      = "gitlab-rails-secret"
    namespace = var.gitlab_namespace
  }
  depends_on = [helm_release.gitlab]
}

resource "aws_secretsmanager_secret" "rails" {
  name       = "${local.prefix}/gitlab-rails-secret"
  kms_key_id = aws_kms_key.gitlab.arn
}

resource "aws_secretsmanager_secret_version" "rails" {
  secret_id     = aws_secretsmanager_secret.rails.id
  secret_string = jsonencode(data.kubernetes_secret_v1.rails.data)
}
